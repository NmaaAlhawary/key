{
  "name": "keys-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "api": "node server/index.js",
    "build": "vite build",
    "build:pages": "GH_PAGES=1 VITE_STATIC=1 vite build && cp dist/index.html dist/404.html",
    "start": "vite build && NODE_ENV=production node server/index.js",
    "seed:demo": "node server/seed-demo.js"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
